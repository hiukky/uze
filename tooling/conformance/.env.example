# This file contains no credential. Copy values into the shell or a local
# ignored .env file before running Docker Compose.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b7728
CLAUDE_VERSION=2.1.237
CODEX_VERSION=0.148.0
OPENCODE_VERSION=1.18.19

# Absolute host directory containing one pre-downloaded GGUF. It is mounted
# read-only and is intentionally not supplied by this repository.
UZE_CONFORMANCE_MODEL_DIR=/absolute/path/to/models
UZE_CONFORMANCE_MODEL_FILE=replace-with-model.gguf
UZE_CONFORMANCE_CONTEXT_SIZE=8192
UZE_CONFORMANCE_PREDICT_TOKENS=512
