/target/
/conformance/target/
/conformance/.env

# Playwright MCP debug output (screenshots, snapshots, console logs)
/.playwright-mcp/
lcov.info

# SBOM: generated at release time from the tag's own Cargo.lock and published
# with the tarballs. A copy in the tree would date from whenever someone last
# ran the command. Both spellings: cargo-cyclonedx names the file after the
# crate unless `--override-filename` says otherwise.
*.cdx.json
uze-sbom.json
.worktrees/

# Local exploration labs — never committed
.labs/

# Demo video: the spec is tracked, the render is not — the published copy in
# web/public is the one the site and the README point at, and committing both
# would put the same ~700KB blob in history twice per recording.
/.demo/*.gif
/.demo/*.png
/.demo/*.cast
