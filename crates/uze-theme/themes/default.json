{
  "version": 1,
  "name": "uze",
  "description": "UZE's own look: a near-black backdrop, warm off-white text, and one signature sage accent doubling as the success hue. Structure comes from hairline dividers, never from filled slabs.",
  "colors": {
    "surface.background": "#0a0c0d",
    "surface.selected": "@accent/17",
    "surface.raised": "~17",
    "surface.raised-subtle": "~12",
    "surface.raised-bright": "~24",
    "surface.recessed": "~06",
    "surface.hover": "~33",

    "text.bright": "#f2f0ea",
    "text.primary": "#e6e4de",
    "text.secondary": "#a8a6a0",
    "text.tertiary": "#c9c7c0",
    "text.muted": "#6b7176",
    "text.dim": "#5b6065",
    "text.faint": "#3d4247",
    "text.inactive": "#9a9892",

    "border.default": "~14",
    "border.faint": "~0d",

    "accent": "#8fd19e",
    "state.success": "@accent",
    "state.warning": "#e0b567",
    "state.danger": "#e0765f",
    "state.info": "#7d97c9",
    "state.in-flight": "#7dbec2",
    "state.landed": "#a38fc9",
    "state.diff-added": "@state.success/1a",
    "state.diff-removed": "@state.danger/1a",

    "ansi.0": "@surface.background",
    "ansi.1": "#e0765f",
    "ansi.2": "#8fd19e",
    "ansi.3": "#e0b567",
    "ansi.4": "#7d97c9",
    "ansi.5": "#a38fc9",
    "ansi.6": "#7dbec2",
    "ansi.7": "@text.tertiary",
    "ansi.8": "@text.dim",
    "ansi.9": "#eb9682",
    "ansi.10": "#afe2bb",
    "ansi.11": "#eecd94",
    "ansi.12": "#9db2db",
    "ansi.13": "#beafdc",
    "ansi.14": "#9fd5d8",
    "ansi.15": "@text.bright"
  },
  "symbols": {
    "mark.native": "√",
    "mark.official": "✓",
    "mark.adapted": "≈",
    "mark.unsupported": "—",
    "mark.warning": "⚠",
    "mark.attention": "!",
    "mark.close": "✕",
    "mark.dot": "•",
    "mark.cross": "×",
    "mark.sparkle": "✦",
    "mark.toggle-off": "○",
    "mark.toggle-on": "◉",

    "status.working": ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
    "status.completed": "✓",
    "status.selected": "●",
    "status.idle": "○",

    "tree.branch": "├─",
    "tree.last": "└─",
    "tree.vertical": "│",
    "tree.divider": "─",
    "tree.column-divider": "│",

    "bar.thick": "▍",
    "bar.medium": "▎",
    "bar.thin": "▏",
    "cursor.text": "▏",

    "arrow.up": "↑",
    "arrow.down": "↓",
    "arrow.external": "↗",
    "arrow.swap": "⇄",
    "arrow.shift": "⇧",
    "arrow.ahead": "⇡",
    "arrow.behind": "⇣",
    "chevron.right": "›",
    "chevron.collapsed": "▸",
    "chevron.expanded": "▾",
    "prompt": "❯",
    "menu": "≡",

    "text.ellipsis": "…",
    "text.em-dash": "—",
    "text.separator": " · ",
    "text.plus-minus": "±"
  },
  "syntax": { "theme": "base16-ocean.dark" }
}
