model {
  developer = actor 'Developer' {
    description 'Defines a project-owned agent environment and selects the runtime that should use it.'
  }

  agentClient = system 'Agent Client' {
    description 'Editor or other interactive client used by the developer. Communicates with a selected agent runtime through ACP when both sides support it.'
  }

  claudeCode = system 'Claude Code' {
    description 'Active target coding-agent runtime. Its native project extensions are optional enhancements, not UZE core configuration.'
  }

  codex = system 'Codex' {
    description 'Active target coding-agent runtime. Its native project extensions are optional enhancements, not UZE core configuration.'
  }

  opencode = system 'OpenCode' {
    description 'Peer coding-agent runtime. It can discover compatible project Agent Skills without becoming UZE core configuration.'
  }

  uze = system 'UZE' {
    description 'Standards-first project-composition layer. It resolves and explains an effective agent environment; it is not a universal harness or protocol bridge.'

    core = container 'UZE Core' {
      description 'Harness-agnostic resolver, store-backed environment composer, and router for a project-owned effective environment.'
      technology 'Rust CLI/library (ADR 004)'

      standardDiscovery = component 'Standards Discoverer' {
        description 'Discovers project-owned instructions through AGENTS.md, reusable Agent Skills, and MCP tool/resource/context configuration without converting their representations.'
      }

      environmentResolver = component 'Effective Environment Resolver' {
        description 'Composes project-owned and registered UZE Store package resources into one extensible effective environment. Runtime resources are reserved but empty.'
      }

      uzeHome = component 'UzeHome' {
        description 'The sole authority for UZE_HOME and its store, state, cache, and runtime paths.'
      }

      uzeStore = component 'UZE Store' {
        description 'Installs each external plugin once, preserves its complete source tree/provenance, and publishes only a standard local Codex marketplace catalog for source-provided native envelopes.'
      }

      capabilityRouter = component 'Capability Router' {
        description 'Routes capabilities from representation and an integration-supplied harness capability description. It contains no named-harness rules.'
      }

      runtimeSelector = component 'Runtime Integration Selector' {
        description 'At the Client-Agent boundary only, selects native ACP, a reliable ACP adapter, a minimal explicit adapter, or no integration.'
      }

      integrationContract = component 'Integration Contract' {
        description 'Port through which integrations first choose native package delivery and consumed resource identities, then choose capability fallbacks. Managed filesystem fallback preserves the real project CWD and is not a shadow workspace.'
      }

      integrationState = component 'Integration State' {
        description 'Records per-harness machine setup: detection, strategy, whether setup completed, and managed attachment artifact paths, under $UZE_HOME/state. Never stores harness secrets.'
      }

      reporter = component 'Compatibility Reporter' {
        description 'Explains representation provenance, compatibility route, exposure state, runtime path, and remaining standards gaps.'
      }

      application = component 'Application Layer' {
        description 'Package-centric product facade. CLI and future TUI invoke setup, add, list, inspect, remove, and doctor here; it composes Store, Engine, plans, receipts, and reconciliation without duplicating lifecycle logic.'
      }

      standardDiscovery -> environmentResolver 'project-owned resources'
      uzeHome -> uzeStore 'owned paths'
      uzeStore -> environmentResolver 'UZE-installed package resources'
      environmentResolver -> capabilityRouter 'effective environment capabilities'
      integrationContract -> capabilityRouter 'harness capability description'
      integrationContract -> environmentResolver 'selected exposure mechanism'
      integrationContract -> integrationState 'setup and managed-attachment state'
      capabilityRouter -> runtimeSelector 'runtime integration need'
      environmentResolver -> reporter 'effective environment'
      capabilityRouter -> reporter 'routes and rationale'
      runtimeSelector -> reporter 'selected runtime path'
      application -> uzeStore 'package lifecycle'
      application -> environmentResolver 'package composition'
      application -> integrationContract 'delivery, inspection, and safe detach'
      application -> integrationState 'receipt ledger and reconciliation'
    }

    claudeIntegration = container 'Claude Integration' {
      description 'Peer harness integration. It is not a canonical source representation; Claude plugin import is a separate foreign-format concern.'
      technology 'Rust adapter'
    }

    codexIntegration = container 'Codex Integration' {
      description 'Peer harness integration. It is not a conversion destination.'
      technology 'Rust adapter'
    }

    opencodeIntegration = container 'OpenCode Integration' {
      description 'Peer harness integration. It declares standards-backed capability routes independently of UZE Core.'
      technology 'Rust adapter'
    }
  }

  developer -> uze.core.application 'uses CLI now and future TUI later'
  uze.core -> uze.claudeIntegration 'effective environment via integration contract'
  uze.core -> uze.codexIntegration 'effective environment via integration contract'
  uze.core -> uze.opencodeIntegration 'effective environment via integration contract'
  uze.claudeIntegration -> claudeCode 'falls back to managed Skill and MCP attachment when no exact native envelope exists'
  uze.codexIntegration -> codex 'prefers standard local marketplace/native plugin delivery and skips consumed components'
  uze.opencodeIntegration -> opencode 'decomposes unknown plugin envelopes into global Skill discovery and managed MCP config'

  developer -> agentClient 'uses to work with a selected agent runtime'
  agentClient -> claudeCode 'ACP when mutually supported; otherwise selected explicit integration'
  agentClient -> codex 'ACP when mutually supported; otherwise selected explicit integration'
  agentClient -> opencode 'ACP when mutually supported; otherwise selected explicit integration'
}
