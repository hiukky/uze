# This file contains no credential. Copy values into the shell or a local
# ignored .env file before running Docker Compose.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm@sha256:468c25f35f3e5ec4e414974f00deab93337b1b4d9953cabcfd3722e59415f834
CLAUDE_VERSION=2.1.237
CODEX_VERSION=0.148.0
OPENCODE_VERSION=1.18.19
# EXPERIMENTAL / CONFORMANCE fourth harness; not a v0 support claim.
GEMINI_VERSION=0.56.0

# Never commit this value. Supply it via shell environment or CI secret, rather
# than copying it into this example file.
# OPENAI_API_KEY=replace-at-runtime
UZE_CONFORMANCE_LITELLM_MODEL=gpt-4o-mini
# Backs the `uze-conformance-reasoning` alias used by the behavior and baseline tiers.
# Must be reasoning-capable: Claude Code sends `reasoning.effort` for any
# model name it does not recognize, which a plain chat model rejects with a
# 400. Measured on the Codex skill route, which is the most demanding:
#   gpt-5      both Codex probes verified
#   o4-mini    MODEL_FAILURE — never invokes the skill tool
#   gpt-4o     HARNESS_FAILURE — emits malformed skill tool arguments
#              ("failed to parse function arguments: missing field `name`")
UZE_CONFORMANCE_REASONING_MODEL=gpt-5
