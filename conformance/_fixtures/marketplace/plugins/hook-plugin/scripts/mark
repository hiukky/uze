#!/bin/sh
# Second handler of the group: runs only when the guard above allowed
# (first-deny-wins). The exit-code contract has no channel for an allowed
# handler to speak on, so it records what it saw beside the plugin instead
# — first-deny-wins itself is proven by hook-order-plugin, whose first
# handler denies and whose second handler's reason must never appear.
printf '%s\t%s\t%s\n' "$HOOK_HARNESS" "$HOOK_TOOL_NATIVE" "$HOOK_COMMAND" \
  >> "${PLUGIN_ROOT}/second-handler.log"
exit 0
