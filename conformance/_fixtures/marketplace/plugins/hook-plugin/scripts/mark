#!/bin/sh
# Second handler of the group: must run only when the guard above allowed.
# It denies with its own marker, so the deny scenario can prove it never
# ran — first-deny-wins is only evidence when the second handler could
# have spoken. hook-allow-plugin is the fixture whose call goes through.
echo "second-handler-reached [tool=$HOOK_TOOL native=$HOOK_TOOL_NATIVE]" >&2
exit 3
