{
  "hooks": {
    "PreToolUse": [
      {
        "id": "protect-order",
        "matcher": "shell",
        "effect": "deny",
        "hooks": [
          { "type": "command", "command": "${PLUGIN_ROOT}/scripts/order-1", "timeout": 10 },
          { "type": "command", "command": "${PLUGIN_ROOT}/scripts/order-2", "timeout": 10 }
        ]
      },
      {
        "id": "protect-order-mcp",
        "matcher": "native:uze-mcp-conformance-uze-conformance_uze_conformance",
        "effect": "deny",
        "hooks": [
          { "type": "command", "command": "${PLUGIN_ROOT}/scripts/order-1", "timeout": 10 },
          { "type": "command", "command": "${PLUGIN_ROOT}/scripts/order-2", "timeout": 10 }
        ]
      },
      {
        "id": "protect-order-observe-mcp",
        "matcher": "native:uze-mcp-conformance-uze-conformance_uze_conformance",
        "effect": "observe",
        "hooks": [
          { "type": "command", "command": "${PLUGIN_ROOT}/scripts/order-1", "timeout": 10 },
          { "type": "command", "command": "${PLUGIN_ROOT}/scripts/order-2", "timeout": 10 }
        ]
      }
    ]
  }
}